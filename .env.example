# Device Configuration
DEVICE=cuda
# Options: cuda, cpu, mps (for Apple Silicon)

# LLM Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_PROVIDER=anthropic
# Options: anthropic, openai
LLM_MODEL=claude-sonnet-4-20250514
# For OpenAI: gpt-4o, gpt-4o-mini

# LiveKit Configuration
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-livekit-server.com

# Redis Configuration (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# Paths
VOICE_SAMPLE_PATH=assets/voice_sample.wav
IDLE_LOOPS_DIR=assets/idle_loops
AVATARS_DIR=assets/avatars

# Avatar Settings
SYSTEM_PROMPT=당신은 친절하고 공감능력이 뛰어난 AI 어시스턴트입니다. 사용자의 감정에 맞춰 대화해주세요.
DEFAULT_LANGUAGE=ko
# Options: ko, en, zh, ja

# Performance Settings
TARGET_FPS=30
MAX_LATENCY_MS=800
AUDIO_SAMPLE_RATE=16000
VIDEO_WIDTH=512
VIDEO_HEIGHT=512

# TTS Settings
TTS_SAMPLE_RATE=24000
TTS_CHUNK_SIZE=4096

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Docker Settings
CUDA_VISIBLE_DEVICES=0
OMP_NUM_THREADS=4

# Model Paths (for Docker)
HF_HOME=/app/models/huggingface
TORCH_HOME=/app/models/torch
MUSETALK_MODEL_DIR=/app/models/musetalk
LIVEPORTRAIT_MODEL_DIR=/app/models/liveportrait
