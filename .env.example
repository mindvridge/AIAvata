# Device Configuration
DEVICE=cuda
# Options: cuda, cpu, mps (for Apple Silicon)

# LLM Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_PROVIDER=anthropic
# Options: anthropic, openai
LLM_MODEL=claude-sonnet-4-20250514
# For OpenAI: gpt-4o, gpt-4o-mini

# LiveKit Configuration
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-livekit-server.com

# Redis Configuration (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# Paths
VOICE_SAMPLE_PATH=assets/voice_sample.wav
IDLE_LOOPS_DIR=assets/idle_loops
AVATARS_DIR=assets/avatars

# Avatar Settings
SYSTEM_PROMPT=?뱀떊? 移쒖젅?섍퀬 怨듦컧?λ젰???곗뼱??AI ?댁떆?ㅽ꽩?몄엯?덈떎. ?ъ슜?먯쓽 媛먯젙??留욎떠 ??뷀빐二쇱꽭??
DEFAULT_LANGUAGE=ko
# Options: ko, en, zh, ja

# Performance Settings
TARGET_FPS=30
MAX_LATENCY_MS=800
AUDIO_SAMPLE_RATE=16000
# VIDEO_WIDTH=784
# VIDEO_HEIGHT=1176
# Note: VIDEO_WIDTH/HEIGHT는 자동 감지됨 (avata_ani.mp4에서)
# 설정하지 않으면 비디오 파일의 실제 크기를 사용합니다.

# TTS Settings
TTS_PROVIDER=edge-tts
# Options: edge-tts (Korean, free), chatterbox (English, voice cloning)
TTS_VOICE=ko-KR-SunHiNeural
# Korean voices: ko-KR-SunHiNeural (female), ko-KR-InJoonNeural (male)
# English voices: en-US-JennyNeural, en-US-GuyNeural
TTS_SAMPLE_RATE=24000
TTS_CHUNK_SIZE=4096

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Docker Settings
CUDA_VISIBLE_DEVICES=0
OMP_NUM_THREADS=4

# Model Paths (for Docker)
HF_HOME=/app/models/huggingface
TORCH_HOME=/app/models/torch
MUSETALK_MODEL_DIR=/app/models/musetalk
LIVEPORTRAIT_MODEL_DIR=/app/models/liveportrait
